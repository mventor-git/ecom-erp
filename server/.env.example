# Server Configuration
PORT=5172

# Your public domain (set this when using custom domain + Cloudflare Tunnel)
# SITE_URL=https://yourstore.com

# Google OAuth (for customer login)
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Stripe Keys
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Admin Credentials
# Generate strong password: node -e "const crypto = require('crypto'); const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@#$%^&*'; let p = ''; for (let i = 0; i < 20; i++) p += chars[crypto.randomInt(0, chars.length)]; console.log(p);"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD_20_CHARS

# Session Secret
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=generate_with_crypto_random_bytes_64

# JWT Secrets
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate_with_crypto_random_bytes_64
JWT_REFRESH_SECRET=generate_with_crypto_random_bytes_64

# Frontend URL (for CORS and Stripe redirects)
CLIENT_URL=http://localhost:5173

# Email (SMTP) Configuration
# For SendGrid: https://sendgrid.com (free: 100 emails/day)
# For Gmail: smtp.gmail.com:587, use an App Password
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
MAIL_FROM=your-email@example.com
ADMIN_EMAIL=admin@example.com
STORE_NAME=Your Store Name

# IMPORTANT SECURITY NOTES:
# 1. NEVER commit the actual .env file to version control
# 2. Generate all secrets with crypto.randomBytes(64).toString('hex')
# 3. Use strong passwords (20+ characters, mixed case, numbers, symbols)
# 4. Rotate API keys regularly (Google OAuth, SendGrid, Stripe)
# 5. Store production secrets in your hosting platform's environment variables